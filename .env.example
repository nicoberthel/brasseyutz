# Obligatoire en production
SESSION_SECRET=changez-moi-32-caracteres-minimum-aleatoires
# Sortie de : node scripts/hash-password.mjs 'votre-mot-de-passe'
# Format scrypt:...:... sans $ — collable tel quel, aucun échappement nécessaire.
ADMIN_PASSWORD_HASH=scrypt:remplacez-par-la-sortie-du-script
# Optionnel
SITE_URL=https://www.brasseyutz.fr
DATA_DIR=./data
CONTACT_EMAIL=
HOST_NAME=
HOST_ADDRESS=
HOST_PHONE=
